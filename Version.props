<Project>

  <!--
    Fonte única da versão do TSK TakeOff.

    Formato distribuído: 1.2.6.1

      1.2.6 = versão funcional do produto
      .1     = número do build, incrementado automaticamente a cada compilação

    O número do build vive em Version.build. O projeto incrementa-o antes de
    gerar os atributos da DLL e sincroniza o instalador e o bundle depois do
    build. AssemblyVersion permanece em 1.2.6.0 para não quebrar referências
    .NET; FileVersion e a versão apresentada ao cliente levam o build completo.

    Como decidir a próxima versão funcional:

      PATCH  (1.2.7) = correção sem recurso novo
      MINOR  (1.3.0) = recurso novo compatível
      MAJOR  (2.0.0) = mudança incompatível no formato ou no produto

    O build (.1, .2, .3...) não substitui essa decisão: identifica cada
    compilação distribuída daquela versão funcional.
  -->

  <PropertyGroup>
    <VersaoBase>1.2.6</VersaoBase>
    <VersaoCanal></VersaoCanal>
    <!-- Valor inicial; o target do csproj lê o Version.build antes de compilar. -->
    <VersaoBuild>0</VersaoBuild>
    <VersaoCompleta>$(VersaoBase)</VersaoCompleta>
    <VersaoDistribuicao>$(VersaoBase).$(VersaoBuild)</VersaoDistribuicao>
    <VersaoNumerica>$(VersaoBase).$(VersaoBuild)</VersaoNumerica>

    <!-- A versão de assembly fica estável dentro da linha 1.2.6. -->
    <AssemblyVersion>$(VersaoBase).0</AssemblyVersion>
    <FileVersion>$(VersaoNumerica)</FileVersion>
    <Version>$(VersaoBase)</Version>
    <InformationalVersion>$(VersaoDistribuicao) ($([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss")) UTC)</InformationalVersion>
  </PropertyGroup>

</Project>
